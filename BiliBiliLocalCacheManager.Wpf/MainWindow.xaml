<Window x:Class="BiliBiliLocalCacheManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="720"
        Width="1180"
        MinHeight="600"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelOperationCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoDeleteCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportMp4Command}" />
    </Window.InputBindings>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10"
                CornerRadius="6"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="缓存根目录" />
                <TextBox Grid.Column="1"
                         MinWidth="240"
                         Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="RootPathTextBox" />
                <Button Grid.Column="2"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        Content="浏览"
                        Command="{Binding BrowseRootCommand}"
                        AutomationProperties.AutomationId="BrowseRootButton" />
                <CheckBox Grid.Column="3"
                          Margin="12,0,12,0"
                          VerticalAlignment="Center"
                          Content="包含未完成缓存"
                          IsChecked="{Binding IncludeIncomplete}"
                          AutomationProperties.AutomationId="IncludeIncompleteCheckBox" />
                <Button Grid.Column="4"
                        MinWidth="90"
                        Content="扫描"
                        Command="{Binding ScanCommand}"
                        AutomationProperties.AutomationId="ScanButton" />
                <Button Grid.Column="5"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        Content="取消"
                        Command="{Binding CancelOperationCommand}"
                        AutomationProperties.AutomationId="CancelOperationButton" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10"
                CornerRadius="6"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Text="关键字" />
                    <TextBox x:Name="KeywordTextBox"
                             Grid.Column="1"
                             MinWidth="200"
                             ToolTip="输入即筛选；按回车立即搜索，清空则显示全部（Ctrl+F 聚焦）"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="KeywordTextBox">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <ComboBox Grid.Column="2"
                              Width="140"
                              Margin="12,0,0,0"
                              SelectedValue="{Binding MatchMode}"
                              SelectedValuePath="Tag"
                              AutomationProperties.AutomationId="MatchModeComboBox">
                        <ComboBoxItem Content="包含 (Contains)" Tag="Contains" IsSelected="True" />
                        <ComboBoxItem Content="等于 (Equals)" Tag="Equals" />
                        <ComboBoxItem Content="前缀 (StartsWith)" Tag="StartsWith" />
                        <ComboBoxItem Content="后缀 (EndsWith)" Tag="EndsWith" />
                    </ComboBox>

                    <CheckBox Grid.Column="3"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Content="分词"
                              IsChecked="{Binding SplitKeywords}"
                              AutomationProperties.AutomationId="SplitKeywordsCheckBox" />
                    <CheckBox Grid.Column="4"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Content="任意关键字"
                              IsChecked="{Binding AnyKeywords}"
                              AutomationProperties.AutomationId="AnyKeywordsCheckBox" />
                    <Button Grid.Column="5"
                            MinWidth="90"
                            Margin="12,0,0,0"
                            Content="搜索"
                            Command="{Binding SearchCommand}"
                            AutomationProperties.AutomationId="SearchButton" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Center"
                              Content="包含分段名"
                              IsChecked="{Binding IncludePartName}"
                              AutomationProperties.AutomationId="IncludePartNameCheckBox" />
                    <CheckBox Grid.Column="1"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Content="包含 UP 主"
                              IsChecked="{Binding IncludeOwnerName}"
                              AutomationProperties.AutomationId="IncludeOwnerNameCheckBox" />
                    <CheckBox Grid.Column="2"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Content="包含 Bvid"
                              IsChecked="{Binding IncludeBvid}"
                              AutomationProperties.AutomationId="IncludeBvidCheckBox" />
                    <CheckBox Grid.Column="3"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Content="包含 Avid"
                              IsChecked="{Binding IncludeAvid}"
                              AutomationProperties.AutomationId="IncludeAvidCheckBox" />
                    <CheckBox Grid.Column="4"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Content="大小写敏感"
                              IsChecked="{Binding CaseSensitive}"
                              AutomationProperties.AutomationId="CaseSensitiveCheckBox" />
                    <TextBlock Grid.Column="5"
                               Margin="20,0,6,0"
                               VerticalAlignment="Center"
                               Text="播放器" />
                    <ComboBox Grid.Column="6"
                              Width="145"
                              SelectedValue="{Binding PreferredPlayer}"
                              SelectedValuePath="Tag"
                              AutomationProperties.AutomationId="PlayerPreferenceComboBox">
                        <ComboBoxItem Content="系统默认优先" Tag="SystemDefaultFirst" IsSelected="True" />
                        <ComboBoxItem Content="仅系统默认" Tag="SystemDefaultOnly" />
                        <ComboBoxItem Content="mpv" Tag="Mpv" />
                        <ComboBoxItem Content="VLC" Tag="Vlc" />
                    </ComboBox>
                </Grid>

            </Grid>
        </Border>

        <Expander Grid.Row="2"
                  Margin="0,10,0,0"
                  IsExpanded="True"
                  Header="存储管理"
                  AutomationProperties.AutomationId="StorageManagementExpander">
            <Border Margin="0,6,0,0"
                    Padding="10"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding StorageOverviewSummary}"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="StorageOverviewSummaryTextBlock" />
                        <TextBlock Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                   Text="{Binding LastStorageMaintenanceSummary}"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="LastStorageCleanupTextBlock" />
                        <ProgressBar Grid.Column="2"
                                     Width="70"
                                     Height="4"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="{Binding IsStorageOverviewBusy}"
                                     AutomationProperties.Name="存储统计进度"
                                     AutomationProperties.AutomationId="StorageOverviewProgressBar" />
                        <Button Grid.Column="3"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Content="刷新"
                                Command="{Binding RefreshStorageOverviewCommand}"
                                AutomationProperties.AutomationId="RefreshStorageOverviewButton" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.65*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="B 站原始缓存" Padding="8">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding OriginalCacheStorageSummary}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OriginalCacheStorageTextBlock" />
                        </GroupBox>

                        <GroupBox Grid.Column="1" Margin="8,0,0,0" Header="转码缓存" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding TranscodeStorageSummary}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="TranscodeCacheSummaryTextBlock" />
                                <WrapPanel Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="保留天数" />
                                    <TextBox Width="58"
                                             MaxLength="4"
                                             ToolTip="允许范围：1–1825 天（最长 5 年）"
                                             Text="{Binding TranscodeCacheRetentionDays, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                             AutomationProperties.Name="转码缓存保留天数"
                                             AutomationProperties.AutomationId="TranscodeCacheRetentionDaysTextBox" />
                                    <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Text="上限 (GB)" />
                                    <TextBox Width="58"
                                             MaxLength="3"
                                             ToolTip="允许范围：1–128 GB"
                                             Text="{Binding TranscodeCacheMaxSizeGigabytes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                             AutomationProperties.Name="转码缓存容量上限（GB）"
                                             AutomationProperties.AutomationId="TranscodeCacheMaxSizeGigabytesTextBox" />
                                </WrapPanel>
                                <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                    <Button MinWidth="80"
                                            Content="打开缓存"
                                            Command="{Binding OpenTranscodeCacheCommand}"
                                            AutomationProperties.AutomationId="OpenTranscodeCacheButton" />
                                    <Button MinWidth="88"
                                            Margin="6,0,0,0"
                                            Content="按策略清理"
                                            Command="{Binding CleanupTranscodeCacheCommand}"
                                            AutomationProperties.AutomationId="CleanupTranscodeCacheButton" />
                                    <Button MinWidth="80"
                                            Margin="6,0,0,0"
                                            Content="一键清空"
                                            Command="{Binding ClearTranscodeCacheCommand}"
                                            AutomationProperties.AutomationId="ClearTranscodeCacheButton" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Margin="8,0,0,0" Header="应用回收站" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding TrashStorageSummary}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="TrashStorageTextBlock" />
                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                    <Button MinWidth="80"
                                            Content="打开回收站"
                                            Command="{Binding OpenTrashCommand}"
                                            AutomationProperties.AutomationId="OpenTrashButton" />
                                    <Button MinWidth="88"
                                            Margin="6,0,0,0"
                                            Content="彻底清空"
                                            ToolTip="永久删除应用回收站中由本应用管理的条目"
                                            Command="{Binding PurgeTrashCommand}"
                                            AutomationProperties.AutomationId="PurgeTrashButton" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </Border>
        </Expander>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                      AlternationCount="2"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      SelectionChanged="OnCacheSelectionChanged"
                      MouseDoubleClick="OnCacheRowDoubleClick"
                      AutomationProperties.AutomationId="CacheDataGrid">
                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="播放所选缓存全部页面"
                                  Command="{Binding PlayBatchCommand}" />
                        <MenuItem Header="导出为 MP4..."
                                  Command="{Binding ExportMp4Command}" />
                        <MenuItem Header="打开所在文件夹"
                                  Command="{Binding OpenFolderCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="PreviewMouseRightButtonDown"
                                     Handler="OnDataGridRowPreviewMouseRightButtonDown" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Avid"
                                        Binding="{Binding Avid}"
                                        Width="90"
                                        ElementStyle="{StaticResource NumericCellStyle}" />
                    <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="UP 主" Binding="{Binding OwnerName}" Width="*" />
                    <DataGridTextColumn Header="BV 号" Binding="{Binding Bvid}" Width="120" />
                    <DataGridTextColumn Header="时长"
                                        Binding="{Binding Duration}"
                                        SortMemberPath="DurationValue"
                                        Width="80"
                                        ElementStyle="{StaticResource NumericCellStyle}" />
                    <DataGridTextColumn Header="分段数"
                                        Binding="{Binding SegmentCount}"
                                        Width="70"
                                        ElementStyle="{StaticResource NumericCellStyle}" />
                    <DataGridTextColumn Header="大小(MB)"
                                        Binding="{Binding SizeMb}"
                                        Width="90"
                                        SortMemberPath="SizeMbValue"
                                        ElementStyle="{StaticResource NumericCellStyle}" />
                    <DataGridTextColumn Header="已完成" Binding="{Binding IsAllCompleted}" Width="70" />
                    <DataGridTextColumn Header="更新时间"
                                        Binding="{Binding LastUpdated}"
                                        SortMemberPath="LastUpdatedValue"
                                        Width="135" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="0"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            MaxWidth="620"
                            Margin="0,46,0,0">
                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}"
                               Text="{Binding EmptyStateTitle}"
                               AutomationProperties.AutomationId="EmptyStateTitleTextBlock" />
                    <TextBlock Style="{StaticResource EmptyStateHintStyle}"
                               TextWrapping="Wrap"
                               Text="{Binding EmptyStateHint}"
                               AutomationProperties.AutomationId="EmptyStateHintTextBlock" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="10"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="分段详情" />

                    <DataGrid Grid.Row="1"
                              Margin="0,8,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                              AlternationCount="2"
                              ItemsSource="{Binding SegmentDetails}"
                              SelectedItem="{Binding SelectedSegmentDetail}"
                              SelectionChanged="OnSegmentSelectionChanged"
                              MouseDoubleClick="OnSegmentRowDoubleClick"
                              AutomationProperties.AutomationId="SegmentDetailDataGrid">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="播放当前页面"
                                          Command="{Binding PlaySelectedPageCommand}" />
                                <MenuItem Header="批量播放选中页面"
                                          Command="{Binding PlayBatchCommand}" />
                                <MenuItem Header="导出选中页面为 MP4..."
                                          Command="{Binding ExportMp4Command}" />
                                <MenuItem Header="打开分段所在文件夹"
                                          Command="{Binding OpenSegmentFolderCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="OnDataGridRowPreviewMouseRightButtonDown" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Segment" Binding="{Binding SegmentKey}" Width="120" />
                            <DataGridTextColumn Header="Page" Binding="{Binding PageIndex}" Width="70" />
                            <DataGridTextColumn Header="分段名" Binding="{Binding PartName}" Width="*" />
                            <DataGridTextColumn Header="结构" Binding="{Binding StructureKind}" Width="140" />
                            <DataGridTextColumn Header="类型" Binding="{Binding MaterialKind}" Width="110" />
                            <DataGridTextColumn Header="大小(MB)" Binding="{Binding SizeMb}" Width="90" />
                            <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="110" />
                            <DataGridTextColumn Header="可播放" Binding="{Binding IsPlayable}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            Visibility="{Binding ShowSegmentEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource EmptyStateHintStyle}"
                                   VerticalAlignment="Center"
                                   Text="在上方列表选择一条缓存，这里会显示它的分段；双击行即可播放。"
                                   AutomationProperties.AutomationId="SegmentEmptyStateTextBlock" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button MinWidth="88"
                        Content="播放所选"
                        Command="{Binding PlayBatchCommand}"
                        AutomationProperties.AutomationId="PlayButton" />
                <Button MinWidth="80"
                        Margin="6,0,0,0"
                        Content="播放下一项"
                        Command="{Binding PlayNextCommand}"
                        AutomationProperties.AutomationId="PlayNextButton" />
                <Button MinWidth="72"
                        Margin="6,0,0,0"
                        Content="清空队列"
                        Command="{Binding ClearQueueCommand}"
                        AutomationProperties.AutomationId="ClearQueueButton" />
                <Button MinWidth="88"
                        Margin="6,0,0,0"
                        Content="导出 MP4"
                        ToolTip="把所选缓存导出成可以直接播放和分享的标准 MP4 文件"
                        Command="{Binding ExportMp4Command}"
                        AutomationProperties.AutomationId="ExportMp4Button" />
                <Button MinWidth="62"
                        Margin="6,0,0,0"
                        Content="删除"
                        Command="{Binding DeleteCommand}"
                        AutomationProperties.AutomationId="DeleteButton" />
                <Button MinWidth="72"
                        Margin="6,0,0,0"
                        Content="撤销删除"
                        Command="{Binding UndoDeleteCommand}"
                        AutomationProperties.AutomationId="UndoDeleteButton" />
                <Button MinWidth="72"
                        Margin="6,0,0,0"
                        Content="清空结果"
                        Command="{Binding ClearCommand}"
                        AutomationProperties.AutomationId="ClearButton" />
                <Button MinWidth="82"
                        Margin="6,0,0,0"
                        Content="导出诊断"
                        Command="{Binding ExportDiagnosticsCommand}"
                        AutomationProperties.AutomationId="ExportDiagnosticsButton" />
                <Button MinWidth="55"
                        Margin="6,0,0,0"
                        Content="帮助"
                        Command="{Binding HelpCommand}"
                        AutomationProperties.AutomationId="HelpButton" />
            </StackPanel>

            <StackPanel Margin="0,0,12,0">
                <TextBlock Foreground="{Binding StatusBrush}"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="StatusTextBlock" />
                <ProgressBar Height="4"
                             MinWidth="120"
                             Margin="0,3,0,0"
                             Focusable="True"
                             IsIndeterminate="{Binding IsBusy}"
                             AutomationProperties.Name="操作进度"
                             AutomationProperties.AutomationId="OperationProgressBar" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           FontSize="11"
                           Text="{Binding StorageSummary}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="StorageSummaryTextBlock" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
