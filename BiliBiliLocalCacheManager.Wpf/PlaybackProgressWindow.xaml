<Window x:Class="BiliBiliLocalCacheManager.Wpf.PlaybackProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x6B63;&#x5728;&#x51C6;&#x5907;&#x64AD;&#x653E;"
        Width="520"
        Height="270"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Closing="OnClosing"
        AutomationProperties.AutomationId="PlaybackProgressWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="&#x6B63;&#x5728;&#x51C6;&#x5907;&#x64AD;&#x653E;&#x6587;&#x4EF6;" />

        <TextBlock x:Name="StageTextBlock"
                   Grid.Row="1"
                   Margin="0,14,0,8"
                   Foreground="#555555"
                   Text="&#x6B63;&#x5728;&#x542F;&#x52A8; FFmpeg&#x2026;"
                   AutomationProperties.AutomationId="PlaybackProgressStage" />

        <ProgressBar x:Name="PreparationProgressBar"
                     Grid.Row="2"
                     Height="18"
                     Minimum="0"
                     Maximum="100"
                     IsIndeterminate="True"
                     AutomationProperties.AutomationId="PlaybackPreparationProgressBar" />

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PercentTextBlock"
                       Grid.Column="0"
                       Text="&#x6B63;&#x5728;&#x8BA1;&#x7B97;&#x8FDB;&#x5EA6;&#x2026;" />
            <TextBlock x:Name="ElapsedTextBlock"
                       Grid.Column="1"
                       Text="&#x5DF2;&#x7528;&#x65F6;&#xFF1A;00:00" />
        </Grid>

        <TextBlock x:Name="RemainingTextBlock"
                   Grid.Row="4"
                   Margin="0,8,0,0"
                   Foreground="#555555"
                   Text="&#x9884;&#x8BA1;&#x5269;&#x4F59;&#xFF1A;&#x8BA1;&#x7B97;&#x4E2D;&#x2026;"
                   AutomationProperties.AutomationId="PlaybackRemainingTime" />

        <Button x:Name="CancelButton"
                Grid.Row="5"
                Width="96"
                Height="32"
                HorizontalAlignment="Right"
                Content="&#x53D6;&#x6D88;&#x8F6C;&#x7801;"
                Click="CancelButton_OnClick"
                AutomationProperties.AutomationId="CancelPlaybackPreparationButton" />
    </Grid>
</Window>
