<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BiliBiliLocalCacheManager.Core\BiliBiliLocalCacheManager.Core.csproj" />
    <ProjectReference Include="..\BiliBiliLocalCacheManager.Playback\BiliBiliLocalCacheManager.Playback.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- ThemeMode（WPF Fluent 主题）在 .NET 10 中仍标记为实验性 API。 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Help\Help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- ApplicationIcon 只决定 exe 图标；窗口 Icon="app.ico" 需要它同时是 WPF 资源，
         而默认的 None glob 会先占用该文件，必须显式移除后再加入。 -->
    <None Remove="app.ico" />
    <Resource Include="app.ico" />
  </ItemGroup>
</Project>
