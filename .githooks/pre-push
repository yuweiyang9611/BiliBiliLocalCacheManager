#!/bin/sh

set -eu

remote_name="$1"
zero_oid="0000000000000000000000000000000000000000"
commit_list="$(mktemp)"
unique_commits="$(mktemp)"

cleanup() {
    rm -f "$commit_list" "$unique_commits"
}

trap cleanup EXIT HUP INT TERM

while read -r local_ref local_oid remote_ref remote_oid; do
    remote_oid="$(printf '%s' "$remote_oid" | tr -d '\r')"

    if [ "$local_oid" = "$zero_oid" ]; then
        continue
    fi

    if [ "$remote_oid" = "$zero_oid" ]; then
        git rev-list "$local_oid" --not --remotes="$remote_name" >>"$commit_list"
    else
        git rev-list "$remote_oid..$local_oid" >>"$commit_list"
    fi
done

sort -u "$commit_list" >"$unique_commits"

is_noreply_email() {
    case "$1" in
        noreply@github.com|*@users.noreply.github.com) return 0 ;;
        *) return 1 ;;
    esac
}

while read -r commit_oid; do
    if [ -z "$commit_oid" ]; then
        continue
    fi

    author_email="$(git show -s --format=%ae "$commit_oid")"
    committer_email="$(git show -s --format=%ce "$commit_oid")"

    if ! is_noreply_email "$author_email"; then
        echo "Push rejected: commit $commit_oid uses a non-noreply author email." >&2
        exit 1
    fi

    if ! is_noreply_email "$committer_email"; then
        echo "Push rejected: commit $commit_oid uses a non-noreply committer email." >&2
        exit 1
    fi
done <"$unique_commits"
